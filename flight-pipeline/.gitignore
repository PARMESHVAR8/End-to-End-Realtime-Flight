# .gitignore

# ─── Secrets ─────────────────────────────────────────────
.env

# ─── Python ──────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ─── Airflow ─────────────────────────────────────────────
airflow/logs/
airflow/*.db

# ─── Jupyter ─────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── OS ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDEs ────────────────────────────────────────────────
.vscode/settings.json
.idea/