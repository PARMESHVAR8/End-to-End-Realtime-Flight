# .env.example
# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# ─── Snowflake ───────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=FLIGHT_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=FLIGHT_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

# ─── Airflow ─────────────────────────────────────────────
AIRFLOW_WEBSERVER_PORT=8080
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here
AIRFLOW_UID=50000

# ─── Kafka ───────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW=flights_raw
KAFKA_TOPIC_CLEAN=flights_clean
KAFKA_GROUP_ID=flight_consumers

# ─── Flight API ──────────────────────────────────────────
AVIATIONSTACK_API_KEY=your_api_key_here

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Monitoring & Alerts ─────────────────────────────────────────────
# Get from: Slack API → Your App → Incoming Webhooks → Add to workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

ALERT_EMAIL=your-team@company.com
PIPELINE_NAME=Flight Data Pipeline
ENVIRONMENT=development   # development / staging / production

# ─── Alert Thresholds ────────────────────────────────────────────────
RAW_FRESHNESS_THRESHOLD_MINS=15
CLEAN_FRESHNESS_THRESHOLD_MINS=30
ANALYTICS_FRESHNESS_THRESHOLD_MINS=60
QUALITY_FLAG_THRESHOLD_PCT=5.0
KAFKA_LAG_ALERT_THRESHOLD=1000
DLQ_ALERT_THRESHOLD=50

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO            # DEBUG / INFO / WARNING / ERROR
LOG_FORMAT=text           # text (development) / json (production)
LOG_DIR=./logs            # Directory for rotating log files